<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Prakrishtha.GraphqlHttpClient</PackageId>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Prakrishta Technologies</Authors>
    <Company>Prakrishta Technologies</Company>
    <Product>GraphqlHttpClient</Product>
    <Description>Client for consuming graphql http services</Description>
    <Copyright>Copyright © Prakrishta Technologies 2017</Copyright>
    <PackageProjectUrl></PackageProjectUrl>
    <RepositoryUrl>https://github.com/sarul84/GraphqlHttpClient</RepositoryUrl>
    <RepositoryType>Public</RepositoryType>
	<Version>1.0.2</Version>
    <PackageTags>C#, NET, Net Core, Graphql, Graphql-client, Graphql client</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
	
  <ItemGroup>
	<None Include="README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

</Project>
